	(text "LIGHT SENSOR - external bare LDR via J6\nGPIO14 -> R5 47k -> GPIO4 -> LDR -> GND\nC1 100n filters ADC; allow 30ms settling.\nDark >100k for 3s; bright <90k; night check 30s.\nR6 is external: no guessed LDR package footprint."
		(exclude_from_sim no)
		(at 300 60 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "0f500d10-ccc2-457e-b790-942ecf19e021")
	)
	(text "SD pull-ups must use switched rail. Remove HIGH drives before OFF.\nReview module decoupling and startup inrush on hardware.\nKeep regulator and PIR powered while ESP32 deep-sleeps."
		(exclude_from_sim no)
		(at 30 270 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "0f859ddd-f19e-4dff-9c79-407ba17e8d5f")
	)
	(text "AM312 pin order retained from your drawing\nConfirm VCC / OUT / GND on actual module."
		(exclude_from_sim no)
		(at 290 177 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "15148091-942e-421d-993d-54130c468791")
	)
	(text "Q1 G-D-S = pins 1-2-3\nQ2 PN2222A E-B-C = pins 1-2-3\nR1 gate-source / R3 base-emitter keep power OFF at reset."
		(exclude_from_sim no)
		(at 300 215 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "546f7647-1c49-4a6f-a529-01a110b75e3c")
	)
	(text "V2 Motherboard - motion wake and switched peripherals"
		(exclude_from_sim no)
		(at 30 22 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "593832e4-3177-42c9-9cca-3f28e6aca2b2")
	)
	(text "Speaker wires solder directly to amplifier before installation.\nBattery wires solder directly to charger before installation.\nThese connections bypass Motherboard copper."
		(exclude_from_sim no)
		(at 83 205 0)
		(effects
			(font
				(size 0.9 0.9)
			)
			(justify left top)
		)
		(uuid "5bdd7454-b81d-43d1-8219-eddb23a296bd")
	)
	(text "U4 footprint is a photo estimate for XL63020-M.\nOrdered XL63070 identity / pad geometry requires confirmation.\nSet and measure 3.3V before connecting loads."
		(exclude_from_sim no)
		(at 30 29 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "648d0de2-07fd-4ee1-8b0c-2b37d25cf3ba")
	)
	(text "GPIO0 = PIR HIGH wake (EXT1)\nGPIO22 = PERIPH_EN, HIGH powers peripherals\nGPIO5 = volume ADC\nGPIO4 = light ADC; GPIO14 = divider excitation\nV2 firmware implemented; hardware validation pending."
		(exclude_from_sim no)
		(at 300 40 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "9852ebf4-9a4f-4290-a523-e15c9eaac98a")
	)
